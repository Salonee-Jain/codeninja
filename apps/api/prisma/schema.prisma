// CodeNinja — data model
// Content tables (Track…Resource) are owned by the seeder and are effectively read-only
// at runtime. Everything from Enrollment down is per-learner state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Pillar {
  FOUNDATIONS
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Runtime {
  javascript
  sql
  html
  remote
}

enum ResourceKind {
  DOCS
  ARTICLE
  VIDEO
  SPEC
  TOOL
}

enum Role {
  LEARNER
  ADMIN
}

enum SubmissionStatus {
  PASSED
  FAILED
  ERROR
}

// ─────────────────────────────────────────────────────────────── content

model Track {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String
  description String
  createdAt   DateTime @default(now())

  days        Day[]
  enrollments Enrollment[]
}

model Day {
  id               String  @id @default(cuid())
  trackId          String
  number           Int
  week             Int
  pillar           Pillar
  title            String
  summary          String
  estimatedMinutes Int
  objectives       String[]
  technologies     String[]

  track     Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  quiz      QuizQuestion[]
  problems  CodeProblem[]
  flashcards Flashcard[]
  resources Resource[]
  project   Project?
  attempts  QuizAttempt[]

  @@unique([trackId, number])
  @@index([trackId, week])
}

model Lesson {
  id               String @id @default(cuid())
  dayId            String
  slug             String
  title            String
  estimatedMinutes Int
  body             String
  order            Int

  day      Day              @relation(fields: [dayId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  notes    Note[]

  @@unique([dayId, slug])
}

model QuizQuestion {
  id           String     @id @default(cuid())
  dayId        String
  prompt       String
  options      String[]
  correctIndex Int
  explanation  String
  difficulty   Difficulty
  order        Int

  day     Day          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([dayId])
}

model CodeProblem {
  id           String     @id @default(cuid())
  dayId        String
  slug         String
  title        String
  difficulty   Difficulty
  runtime      Runtime
  language     String?
  statement    String
  starterCode  String
  solutionCode String
  hints        String[]
  sqlSetup     String?
  xp           Int
  order        Int

  day         Day          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  tests       TestCase[]
  submissions Submission[]

  @@unique([dayId, slug])
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  name      String
  assertion String
  hidden    Boolean @default(false)
  points    Int     @default(1)
  order     Int

  problem CodeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Flashcard {
  id    String   @id @default(cuid())
  dayId String
  front String
  back  String
  tags  String[]
  order Int

  day     Day               @relation(fields: [dayId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([dayId])
}

model Resource {
  id    String       @id @default(cuid())
  dayId String
  label String
  url   String
  kind  ResourceKind
  order Int

  day Day @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model Project {
  id              String   @id @default(cuid())
  dayId           String   @unique
  slug            String   @unique
  title           String
  brief           String
  estimatedHours  Int
  stretchGoals    String[]
  repoStarter     String?

  day      Day           @relation(fields: [dayId], references: [id], onDelete: Cascade)
  tasks    ProjectTask[]
  progress ProjectProgress[]
}

model ProjectTask {
  id        String @id @default(cuid())
  projectId String
  label     String
  order     Int

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  states  ProjectTaskState[]

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────── learner state

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String
  role             Role     @default(LEARNER)
  avatarUrl        String?
  xp               Int      @default(0)
  streak           Int      @default(0)
  longestStreak    Int      @default(0)
  lastActiveOn     DateTime?
  dailyGoalMinutes Int      @default(300)
  timezone         String   @default("UTC")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  quizAttempts    QuizAttempt[]
  submissions     Submission[]
  reviews         FlashcardReview[]
  projectProgress ProjectProgress[]
  taskStates      ProjectTaskState[]
  activity        Activity[]
  notes           Note[]
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  startedAt DateTime @default(now())
  targetEndAt DateTime?
  currentDay Int     @default(1)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  secondsSpent Int      @default(0)
  scrollPct   Int       @default(0)
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  dayId       String
  score       Int
  total       Int
  passed      Boolean
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     Day          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, dayId])
}

model QuizAnswer {
  id            String  @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int
  correct       Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  problemId   String
  code        String
  status      SubmissionStatus
  passedCount Int
  totalCount  Int
  results     Json
  runtimeMs   Int              @default(0)
  xpAwarded   Int              @default(0)
  createdAt   DateTime         @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem CodeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
}

// SM-2 spaced repetition state, one row per (user, card).
model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  flashcardId  String
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime @default(now())
  lastGrade    Int?
  reviewedAt   DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
}

model ProjectProgress {
  id          String    @id @default(cuid())
  userId      String
  projectId   String
  repoUrl     String?
  liveUrl     String?
  notes       String?
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model ProjectTaskState {
  id     String  @id @default(cuid())
  userId String
  taskId String
  done   Boolean @default(false)
  doneAt DateTime?

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

// One row per user per calendar day — powers the streak and the contribution heatmap.
model Activity {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @db.Date
  minutes  Int      @default(0)
  xp       Int      @default(0)
  lessons  Int      @default(0)
  problems Int      @default(0)
  cards    Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}
