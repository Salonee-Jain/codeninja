# ── database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ninja:ninja@localhost:5432/codeninja?schema=public"

# ── api ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000
JUDGE_TIMEOUT_MS=5000

# Optional: a Piston-compatible executor for Python/Go/Java/PHP problems.
# Self-host with `docker run -p 2000:2000 ghcr.io/engineer-man/piston`
# REMOTE_EXECUTOR_URL=http://localhost:2000/api/v2

# ── web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
