# ── database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ninja:ninja@localhost:5432/codeninja?schema=public"

# ── api ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000
JUDGE_TIMEOUT_MS=5000

# Optional: a Piston-compatible executor for Python/Go/Java/PHP problems.
# Self-host with `docker run -p 2000:2000 ghcr.io/engineer-man/piston`
# REMOTE_EXECUTOR_URL=http://localhost:2000/api/v2

# ── ai tutor (optional) ─────────────────────────────────────────────────
# Set ONE provider key and the tutor turns itself on. Set none and it stays off:
# /api/tutor/ask answers 503 and the web app hides the launcher.
#
# Gemini has a free tier — get a key at https://aistudio.google.com (no card needed).
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...      # console.anthropic.com, prepaid credits
# OPENAI_API_KEY=sk-...             # platform.openai.com, prepaid credits
#
# Only needed when more than one key is set. Unset = first key found, in the order
# gemini → anthropic → openai.
# TUTOR_PROVIDER=gemini
#
# Unset = the provider's default (gemini-2.5-flash / claude-opus-5 / gpt-4o-mini).
# TUTOR_MODEL=
# TUTOR_MAX_TOKENS=4000

# ── web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
